# 현재 서버 설정 예시는 .env.compose.example, 프론트 공개 설정은 frontend/.env.example을 참고하세요.
# 루트 .env는 현재 Django 설정을 자동 로드하지 않습니다. Compose에는 --env-file을 명시하세요.
# 실제 API 키·비밀번호를 이 공유용 예시에 넣지 마세요.

# Django에서 접근 가능한 내부 FastAPI 주소. 빈 값은 비활성입니다.
# 호스트 실행 예: http://127.0.0.1:8001 (Compose에서는 호스트/네트워크 주소 확인)
ARTI_MODEL_SERVICE_URL=
# 격리 검증에서만 새 취향 v2 생성을 켭니다.
ARTI_TASTE_PROFILE_V2_ENABLED=false
# 비교를 승인한 태그 모델 signature의 SHA256입니다. 공란이면 고정 순서를 사용합니다.
ARTI_TASTE_APPROVED_SIGNATURE_SHA256=

# TP1a: FastAPI 프로세스의 CLIP 모델/processor를 같은 HF commit에 고정하는 선택 설정입니다.
# 40자리 commit SHA를 직접 확인해 입력하세요. 빈 값/출처 불명 로컬 폴더는 tagEvidence=null입니다.
# 현재 Compose에는 모델 서비스가 없으며 이 파일은 자동 로드되지 않습니다. 실제 운영 env는 변경하지 않습니다.
ARTI_CLIP_REVISION=
