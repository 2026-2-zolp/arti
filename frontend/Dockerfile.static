# CI에서 정적 산출물을 빌드한 뒤 작은 실행 호스트에서는 Nginx만 실행합니다.
FROM node:22-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
ENV VITE_API_TARGET=django VITE_API_BASE=/api
RUN npm run build
FROM nginx:1.28-alpine
COPY nginx.static.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
