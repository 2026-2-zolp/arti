# Optional: no file is required for the default host Django development path.
# Copy to ignored frontend/.env.local only when overriding these public settings.
VITE_API_TARGET=django
VITE_API_PROXY=http://127.0.0.1:4018
# Legacy Express: set TARGET=express and PROXY=http://127.0.0.1:4000 together.
# API base is normally /api. Never place server API keys in any VITE_* variable.
# Restart dev after changes. Rebuild before preview if TARGET or API_BASE changes.
