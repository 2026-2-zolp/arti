# Copy to ignored .env.compose; replace both placeholders with independent random strings.
ARTI_DB_PASSWORD=replace-with-random-password
DJANGO_SECRET_KEY=replace-with-at-least-32-random-characters
ARTI_ENV=development
ALLOW_TEST_FIXTURES=false
ARTI_API_PORT=4018
ARTI_UI_PORT=5178
## Optional cross-origin frontend origins, comma-separated. Empty keeps proxy-only same-origin use.
ARTI_ALLOWED_ORIGINS=

# Server-side text generation. Keep disabled until key + model are configured.
# Never place the key in VITE_* or commit .env.compose.
ARTI_LLM_PROVIDER=disabled
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
# Optional task overrides; empty uses OPENAI_MODEL.
ARTI_LLM_MODEL_ANSWER=
ARTI_LLM_MODEL_EXPLANATION=
ARTI_LLM_MODEL_SUMMARY=
ARTI_LLM_MODEL_GUIDE=
ARTI_LLM_MODEL_INTERPRET=
ARTI_LLM_JSON_MODE=true
ARTI_LLM_TOKEN_PARAMETER=max_completion_tokens
