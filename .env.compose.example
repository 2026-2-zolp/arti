# 공유용 설정 예시입니다. 실제 키·비밀번호는 Git 제외 파일에 입력하세요.
# PostgreSQL 비밀번호입니다. 기존 DB 사용 중에는 임의 변경하지 마세요.
ARTI_DB_PASSWORD=replace-with-random-password
# Django 서버 비밀값입니다. 32자 이상의 무작위 값을 사용합니다.
DJANGO_SECRET_KEY=replace-with-at-least-32-random-characters
# 실행 환경입니다. 로컬은 development이며 운영과 시험 자료를 구분합니다.
ARTI_ENV=development
# 합성 시험자료 적재 허용 여부입니다. 실제 자료 작업은 false로 유지합니다.
ALLOW_TEST_FIXTURES=false
# 호스트에서 Django API에 접속할 포트입니다.
ARTI_API_PORT=4018
# 호스트에서 개발 프론트에 접속할 포트입니다.
ARTI_UI_PORT=5178
# 직접 교차 출처 요청을 허용할 프론트 주소입니다. 동일 출처 프록시만 쓰면 비웁니다.
ARTI_ALLOWED_ORIGINS=

# disabled는 미연결, openai_compatible은 아래 키·모델로 텍스트 API를 사용합니다.
ARTI_LLM_PROVIDER=disabled
# 서버 전용 API 키입니다. 실제 값은 Git 제외 .env.compose에만 넣고 이 공유 예시에는 넣지 마세요.
OPENAI_API_KEY=
# Chat Completions 호환 API의 기본 주소입니다. /chat/completions는 코드가 붙입니다.
OPENAI_BASE_URL=https://api.openai.com/v1
# 계정에서 사용 가능한 공통 모델 ID입니다. 키만 입력하고 여기를 비우면 호출할 수 없습니다.
OPENAI_MODEL=
# 도슨트 대화 전용 모델입니다. 비우면 OPENAI_MODEL을 사용합니다.
ARTI_LLM_MODEL_ANSWER=
# 쉬운 작품해설 전용 모델입니다. 비우면 공통 모델을 사용합니다.
ARTI_LLM_MODEL_EXPLANATION=
# 해설 요약 전용 모델입니다. 비우면 공통 모델을 사용합니다.
ARTI_LLM_MODEL_SUMMARY=
# 관찰 질문·힌트 작성 전용 모델입니다. 비우면 공통 모델을 사용합니다.
ARTI_LLM_MODEL_GUIDE=
# 관람 기록 해석 전용 모델입니다. 비우면 공통 모델을 사용합니다.
ARTI_LLM_MODEL_INTERPRET=
# JSON 객체 응답 옵션입니다. 서버가 지원하지 않을 때만 false를 검토합니다.
ARTI_LLM_JSON_MODE=true
# 출력 토큰 인자 이름입니다. 기본 max_completion_tokens, 일부 호환 서버는 max_tokens입니다.
ARTI_LLM_TOKEN_PARAMETER=max_completion_tokens

# Django에서 접근 가능한 내부 FastAPI 주소. 빈 값은 비활성입니다.
# 호스트 실행 예: http://127.0.0.1:8001 (Compose에서는 호스트/네트워크 주소 확인)
ARTI_MODEL_SERVICE_URL=
# 격리 검증에서만 새 취향 v2 생성을 켭니다.
ARTI_TASTE_PROFILE_V2_ENABLED=false
ARTI_TASTE_APPROVED_SIGNATURE_SHA256=
